# URL publique du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL canonique du portfolio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Variables strictement serveur — ne jamais préfixer par NEXT_PUBLIC_
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Ancien format accepté en secours :
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secrets aléatoires distincts, par exemple avec : openssl rand -hex 32
CONTACT_RATE_LIMIT_SECRET=replace-with-a-long-random-secret
COMMENT_RATE_LIMIT_SECRET=replace-with-a-long-random-secret
COMMENT_VISITOR_SECRET=replace-with-a-long-random-secret
